# JM WiFi Cloud - VPS Configuration
PORT=3000
NODE_ENV=production

# Domain (jmtechsolution.cloud)
BASE_URL=https://jmwifi.jmtechsolution.cloud

# JWT secret for admin and device auth
JWT_SECRET=change-this-to-a-long-random-string

# Coin rate: minutes per peso/coin
MINUTES_PER_COIN=5
DEFAULT_RATE_PER_HOUR=10

# MikroTik API (optional - per-site override in DB)
MIKROTIK_HOST=192.168.88.1
MIKROTIK_USER=admin
MIKROTIK_PASS=changeme
