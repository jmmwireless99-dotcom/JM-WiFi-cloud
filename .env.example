# JM WiFi Cloud — All Vendo (jmtechsolution.cloud)
PORT=3000
NODE_ENV=production

# Public URL on VPS (origin only, no trailing slash)
BASE_URL=https://jmtechsolution.cloud

# URL path prefix when app is served under a subpath (e.g. /allvendo)
BASE_PATH=/allvendo

# JWT for admin dashboard sessions
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES=7d

# Bootstrap admin (used only on first DB init)
ADMIN_EMAIL=admin@jmtechsolution.cloud
ADMIN_PASSWORD=admin123

# Optional legacy API key for /api/admin/create-site scripts
ADMIN_KEY=change-me-admin-key

# Defaults
MINUTES_PER_COIN=5
DEFAULT_RATE_PER_HOUR=10

# Optional global MikroTik defaults (per-vendo override in dashboard)
MIKROTIK_HOST=192.168.88.1
MIKROTIK_USER=admin
MIKROTIK_PASS=changeme
