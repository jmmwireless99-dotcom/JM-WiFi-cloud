[Unit]
Description=JM WiFi Cloud Server
After=network.target

[Service]
Type=simple
User=www-data
WorkingDirectory=/opt/jmtechsolution
ExecStart=/usr/bin/node server/index.js
Restart=on-failure
RestartSec=10
Environment=NODE_ENV=production
EnvironmentFile=/opt/jmtechsolution/.env

[Install]
WantedBy=multi-user.target
