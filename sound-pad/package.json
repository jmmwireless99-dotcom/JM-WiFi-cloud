{
  "name": "john-joy-sound-pad",
  "version": "1.0.0",
  "private": true,
  "description": "John & Joy DJ Sound Pad — mobile and desktop app",
  "main": "electron/main.cjs",
  "scripts": {
    "icons": "node scripts/generate-icons.mjs",
    "build:web": "npm run icons && node scripts/copy-www.mjs",
    "desktop": "npm run build:web && electron .",
    "desktop:build": "npm run build:web && electron-builder",
    "desktop:build:win": "npm run build:web && electron-builder --win",
    "desktop:build:mac": "npm run build:web && electron-builder --mac",
    "desktop:build:linux": "npm run build:web && electron-builder --linux",
    "cap:init": "npm run build:web && npx cap sync",
    "cap:android": "npm run cap:init && npx cap open android",
    "cap:sync": "npx cap sync"
  },
  "dependencies": {
    "@capacitor/android": "^7.0.0",
    "@capacitor/core": "^7.0.0",
    "@capacitor/haptics": "^7.0.0",
    "@capacitor/splash-screen": "^7.0.0",
    "@capacitor/status-bar": "^7.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.0.0",
    "electron": "^35.0.0",
    "electron-builder": "^25.1.8",
    "pngjs": "^7.0.0"
  },
  "build": {
    "appId": "com.johnjoy.soundpad",
    "productName": "John & Joy Sound Pad",
    "directories": {
      "output": "dist-desktop"
    },
    "files": [
      "www/**/*",
      "electron/**/*",
      "icons/**/*",
      "package.json"
    ],
    "win": {
      "target": ["nsis", "portable"],
      "icon": "icons/icon-512.png"
    },
    "mac": {
      "target": ["dmg"],
      "icon": "icons/icon-512.png",
      "category": "public.app-category.music"
    },
    "linux": {
      "target": ["AppImage", "deb"],
      "icon": "icons/icon-512.png",
      "category": "Audio"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
